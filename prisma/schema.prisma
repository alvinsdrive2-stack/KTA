generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String        @id @default(cuid())
  daerahId              String?
  name                  String
  email                 String        @unique
  password              String
  role                  UserRole      @default(DAERAH)
  isActive              Boolean       @default(true)
  ktpUrl                String?
  fotoUrl               String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  approvals             Approval[]
  bulkPaymentsSubmitted BulkPayment[] @relation("BulkPaymentSubmittedBy")
  bulkPaymentsVerified  BulkPayment[] @relation("BulkPaymentVerifiedBy")
  ktaRequests           KTARequest[]
  sessions              Session[]
  daerah                Daerah?       @relation(fields: [daerahId], references: [id])

  @@index([daerahId], map: "users_daerahId_fkey")
  @@map("users")
}

model Session {
  id           String @id @default(cuid())
  sessionToken String @unique
  userId       String
  expires      BigInt
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_userId_fkey")
  @@map("sessions")
}

model Daerah {
  id                   String        @id @default(cuid())
  namaDaerah           String
  kodeDaerah           String        @unique
  alamat               String?
  telepon              String?
  email                String?
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  kodePropinsi         String?
  diskonPersen         Int           @default(0)
  lastSequenceAhli     Int           @default(0)
  lastSequenceTeknisi  Int           @default(0)
  lastSequenceOperator Int           @default(0)
  bulkPayments         BulkPayment[]
  ktaRequests          KTARequest[]
  regionPrices         RegionPrice[]
  users                User[]

  @@map("daerah")
}

model RegionPrice {
  id        String   @id @default(cuid())
  daerahId  String
  hargaKta  Int
  tahun     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  daerah    Daerah   @relation(fields: [daerahId], references: [id])

  @@unique([daerahId, tahun])
  @@map("region_prices")
}

model Subklasifikasi {
  id                 String       @id @default(cuid())
  idKlasifikasi      String
  idSubklasifikasi   String
  kodeSubklasifikasi String       @unique
  subklasifikasi     String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  ktaRequests        KTARequest[]

  @@unique([idKlasifikasi, idSubklasifikasi])
  @@map("subklasifikasi")
}

model KTARequest {
  id                 String          @id @default(cuid())
  idIzin             String          @unique
  daerahId           String
  requestedBy        String
  nik                String
  nama               String
  jabatanKerja       String
  subklasifikasi     String?
  jenjang            String
  noTelp             String
  email              String
  alamat             String
  tanggalDaftar      DateTime
  status             KTAStatus       @default(DRAFT)
  hargaRegion        Int
  pusatApprovedBy    String?
  pusatApprovedAt    DateTime?
  kartuGeneratedPath String?
  qrCodePath         String?         @db.Text
  nomorKTA           String?         @unique
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  fotoUrl            String?
  fotoData           String?         @db.Text
  ktpUrl             String?
  subklasifikasiId   String?
  diskonPersen       Int?            @default(0)
  hargaBase          Int?
  hargaFinal         Int?
  isUpgrade          Boolean         @default(false)
  upgradeFromKtaId   String?
  hargaLama          Int?
  hargaUpgrade       Int?
  approvals          Approval[]
  documents          KTADocument[]
  daerah             Daerah          @relation(fields: [daerahId], references: [id])
  requestedByUser    User            @relation(fields: [requestedBy], references: [id])
  klasifikasi        Subklasifikasi? @relation(fields: [subklasifikasiId], references: [id])
  upgradeFromKta     KTARequest?     @relation("KTAUpgrade", fields: [upgradeFromKtaId], references: [id])
  upgradeToKtas      KTARequest[]    @relation("KTAUpgrade")
  payments           Payment[]
  qrScans            QRScan[]

  @@index([daerahId], map: "kta_requests_daerahId_fkey")
  @@index([requestedBy], map: "kta_requests_requestedBy_fkey")
  @@index([subklasifikasiId], map: "kta_requests_subklasifikasiId_fkey")
  @@index([upgradeFromKtaId], map: "kta_requests_upgradeFromKtaId_fkey")
  @@map("kta_requests")
}

model KTADocument {
  id           String       @id @default(cuid())
  ktaRequestId String
  jenis        DocumentType
  link         String
  createdAt    DateTime     @default(now())
  ktaRequest   KTARequest   @relation(fields: [ktaRequestId], references: [id], onDelete: Cascade)

  @@index([ktaRequestId], map: "kta_documents_ktaRequestId_fkey")
  @@map("kta_documents")
}

model Payment {
  id               String        @id @default(cuid())
  ktaRequestId     String
  invoiceNumber    String
  rekeningTujuan   String
  jumlah           Int
  buktiBayarLink   String?
  statusPembayaran PaymentStatus @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  bulkPaymentId    String?
  bulkPayment      BulkPayment?  @relation(fields: [bulkPaymentId], references: [id])
  ktaRequest       KTARequest    @relation(fields: [ktaRequestId], references: [id], onDelete: Cascade)

  @@index([bulkPaymentId], map: "payments_bulkPaymentId_fkey")
  @@index([ktaRequestId], map: "payments_ktaRequestId_fkey")
  @@map("payments")
}

model BulkPayment {
  id                    String        @id @default(cuid())
  invoiceNumber         String        @unique
  daerahId              String
  totalJumlah           Int
  totalNominal          Int
  buktiPembayaranUrl    String
  status                PaymentStatus @default(PENDING)
  verifiedBy            String?
  verifiedAt            DateTime?
  submittedBy           String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  isEnrolment           Boolean       @default(false)
  keterangan            String?
  midtransToken         String?
  midtransRedirectUrl   String?
  midtransTransactionId String?
  midtransPaymentType   String?
  daerah                Daerah        @relation(fields: [daerahId], references: [id])
  submittedByUser       User          @relation("BulkPaymentSubmittedBy", fields: [submittedBy], references: [id])
  verifiedByUser        User?         @relation("BulkPaymentVerifiedBy", fields: [verifiedBy], references: [id])
  payments              Payment[]

  @@index([daerahId], map: "bulk_payments_daerahId_fkey")
  @@index([submittedBy], map: "bulk_payments_submittedBy_fkey")
  @@index([verifiedBy], map: "bulk_payments_verifiedBy_fkey")
  @@map("bulk_payments")
}

model Approval {
  id             String         @id @default(cuid())
  ktaRequestId   String
  approvedBy     String
  status         ApprovalStatus
  catatan        String?
  createdAt      DateTime       @default(now())
  approvedByUser User           @relation(fields: [approvedBy], references: [id])
  ktaRequest     KTARequest     @relation(fields: [ktaRequestId], references: [id], onDelete: Cascade)

  @@index([approvedBy], map: "approvals_approvedBy_fkey")
  @@index([ktaRequestId], map: "approvals_ktaRequestId_fkey")
  @@map("approvals")
}

model QRScan {
  id           String     @id @default(cuid())
  ktaRequestId String
  ipAddress    String?
  userAgent    String?
  scannedAt    DateTime   @default(now())
  ktaRequest   KTARequest @relation(fields: [ktaRequestId], references: [id], onDelete: Cascade)

  @@index([ktaRequestId], map: "qr_scans_ktaRequestId_fkey")
  @@map("qr_scans")
}

model JabatanKerja {
  id                  String   @id @default(cuid())
  lspIdKlasifikasi    String
  klasifikasi         String
  klasifikasiEn       String?
  lspSubKlasifikasiId String
  subklasifikasi      String
  subklasifikasiEn    String?
  lspKualifikasiId    String
  kualifikasi         String
  kualifikasiEn       String?
  idJabker            String
  idJabatanKerja      String   @unique
  jabatanKerja        String
  workPosition        String?
  jenjangId           String
  acuan               String?
  keterangan          String?
  status              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([subklasifikasi])
  @@index([jenjangId])
  @@index([idJabatanKerja])
  @@map("jabatan_kerja")
}

model LookupJabker {
  id           String   @id @default(cuid())
  kodeJabker   String   @unique
  jabatanKerja String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("lookup_jabker")
}

enum UserRole {
  DAERAH
  PUSAT
  ADMIN
  KEUANGAN
}

enum KTAStatus {
  DRAFT
  FETCHED_FROM_SIKI
  EDITED
  WAITING_PAYMENT
  READY_FOR_PUSAT
  APPROVED_BY_PUSAT
  READY_TO_PRINT
  PRINTED
  REJECTED
  UPGRADE_PENDING
  UPGRADE_PAID
  IMPORTED_PENDING_DOCS
}

enum DocumentType {
  KTP
  FOTO
  SERTIFIKAT
  SURAT_KETERANGAN
}

enum PaymentStatus {
  PENDING
  PAID
  VERIFIED
  REJECTED
}

enum ApprovalStatus {
  APPROVED
  REJECTED
  REVISION
}
