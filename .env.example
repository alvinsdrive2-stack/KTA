# Contoh konfigurasi environment.
# Copy jadi `.env` lalu isi nilainya. JANGAN commit file `.env` yang asli.

# --- Database ---
# Koneksi Postgres (Supabase pooler). Ganti password-nya — yang lama ada di git history.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Auth (NextAuth) ---
# Generate pakai: openssl rand -base64 32
NEXTAUTH_SECRET=ganti-dengan-string-acak-panjang
# Domain server ini. Dipakai NextAuth buat bikin URL callback & cookie.
NEXT_PUBLIC_APP_URL=https://domain-anda.example
# Sesi nganggur berapa menit sebelum dianggap logout.
SESSION_IDLE_MINUTES=60
# Batas jumlah device aktif per user. Login di device baru akan nge-evict yang lama.
MAX_DEVICES_PER_USER=2

# --- Midtrans ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# `sandbox` atau `production`
MIDTRANS_ENVIRONMENT=sandbox
# Catatan: NEXT_PUBLIC_MIDTRANS_CLIENT_KEY dan NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION
# diturunkan otomatis dari dua variabel di atas (lihat next.config.js).

# --- SIKI ---
# Tiga token buat tiga endpoint SIKI yang berbeda, dengan fallback berurutan.
SIKI_TOKEN_GKK=
SIKI_TOKEN_GATAKSINDO=
SIKI_TOKEN_MIK=

# --- Cron ---
# Cron server wajib kirim: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- Upload ---
# Folder penyimpanan file anggota (KTP, foto, bukti bayar).
# Sengaja di LUAR `public/` — file di `public/` disajikan statis sama Next.js
# dan langsung ke-bypass cek session di route handler.
# Default kalau dikosongkan: <cwd>/storage/uploads
UPLOAD_DIR=./storage/uploads

# --- Lain-lain ---
# Batas ukuran gambar buat sharp/libvips (pixel).
VIPS_MAX_PIXEL_LIMIT=

# --- Email (SMTP) ---
# Domain gatensi.or.id pakai Google Workspace. Google udah matiin SMTP basic auth
# (password login biasa bakal ditolak) — yang jalan cuma dua ini:
#   1. App Password  -> aktifin 2FA di akun, bikin App Password, taruh di SMTP_PASS
#   2. SMTP relay    -> SMTP_HOST=smtp-relay.gmail.com, IP server didaftarin di admin console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# `true` cuma kalau pakai port 465. Default: otomatis (port 465 = true).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Nama pengirim yang muncul di inbox.
SMTP_FROM_NAME=GATENSI
# Alamat pengirim. Kosongin = pakai SMTP_USER.
SMTP_FROM=
